# ─── Go ──────────────────────────────────────────────────────────────────────
FROM deps AS go
# Podman 6 needs Go >= 1.25 and trixie has 1.24. Hashes from https://go.dev/dl/.
ARG GO_VERSION=1.27.3
ARG GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
COPY pi-coding-agent-builder/build-go.sh /build/
RUN bash /build/build-go.sh

# ─── Rust ────────────────────────────────────────────────────────────────────
FROM deps AS rust
# Inherited from the pre-FROM block.
ARG RUST_VERSION
ARG RUST_DIST_DATE
ARG RUST_SHA256_X86_64
ARG RUST_SHA256_AARCH64
COPY pi-coding-agent-builder/build-rust.sh /build/
RUN bash /build/build-rust.sh

# ─── Node.js ─────────────────────────────────────────────────────────────────
# NODE_SOURCE=prebuilt (default) stages the official nodejs.org tarball — seconds, and
# byte-identical to the Node the `node:` base image shipped, since that image is this
# same tarball extracted into /usr/local. NODE_SOURCE=build compiles from source
# instead: ~65 minutes on a 9-core/8 GB machine, and only worth it to change the
# configure flags. Either way the same parity checks run. See build-node.sh.
FROM deps AS node
# 26.6.0 rather than the 26.3.1 the old base-image tag pinned: v26.5.1 was a security
# release, so that pin was missing fixes. All three hashes come from
# https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt — the source tarball for
# NODE_SOURCE=build, the per-arch binaries for prebuilt. Bump all four together.
ARG NODE_VERSION=26.13.0
ARG NODE_SRC_SHA256=986ead18ef18256831bae3e57d94aef680a7b84cfd4044f3e8471f833fbd7191
ARG NODE_BIN_SHA256_X64=d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997
ARG NODE_BIN_SHA256_ARM64=406fe3fbde1c054adff8b297c16fdb5af6659db327c1ac8acd46b56ef1af9a92
ARG NODE_SOURCE=prebuilt
ARG MAKE_JOBS=""
COPY --from=rust /out/ /
COPY pi-coding-agent-builder/build-node.sh /build/
RUN bash /build/build-node.sh

# ─── podman ──────────────────────────────────────────────────────────────────
FROM deps AS podman
# PODMAN_COMMIT is the pin that matters; the tag is a mutable pointer and the build
# fails if it ever resolves elsewhere. It must be the COMMIT, not the annotated tag
# object — see clone_verified in common.sh for how to get it.
ARG PODMAN_VERSION=v6.1.4
ARG PODMAN_COMMIT=464c15fec06f0074c916f9eff87c4806869c2833
COPY --from=go /out/ /
COPY pi-coding-agent-builder/build-podman.sh /build/
RUN bash /build/build-podman.sh

# ─── netavark + aardvark-dns ─────────────────────────────────────────────────
FROM deps AS network
# Both must be 2.0.0 to match podman 6 — see build-network.sh. The vendor sha256 is the
# value published in each release's own `sha256sum` asset.
ARG NETAVARK_VERSION=v2.1.0
ARG NETAVARK_COMMIT=8e91ad1d947ed325327b638f0cb906bea1f7d0ab
ARG NETAVARK_VENDOR_SHA256=532779573b7f4c2606e43f8471132bb9072417feed9ee06a4e309cf3fa066ab8
ARG AARDVARK_VERSION=v2.1.0
ARG AARDVARK_COMMIT=cd7417681229219059939bdd9f0b3bd9ac9abb08
ARG AARDVARK_VENDOR_SHA256=6e6366828d4cd2ccf3cfe07657d8aba083045605696b4f74967c2c8340f51500
COPY --from=rust /out/ /
COPY pi-coding-agent-builder/build-network.sh /build/
RUN bash /build/build-network.sh

# ─── Optional Tool: mold ────────────────────────────────────────────────────
FROM deps AS mold
ARG MOLD_VERSION=v3.0.0
ARG MOLD_COMMIT=8de38c35a2df16a25f7ff87ac3ad07156a925beb
RUN apt-get update && apt-get install -y --no-install-recommends cmake ninja-build && rm -rf /var/lib/apt/lists/*
COPY pi-coding-agent-builder/tools/mold/build.sh /build/tools/mold/
RUN bash /build/tools/mold/build.sh

FROM scratch AS stage-mold
COPY --from=mold /out/ /

