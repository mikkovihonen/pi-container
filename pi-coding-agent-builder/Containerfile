# Toolchain builder for the pi-coding-agent and pi-coding-agent-proxy images.
#
# Compiles everything those images run on and stages it — one tree per component, so a
# consumer can copy just the parts it needs (see "the shipped artefact" at the bottom):
#
#   Node.js                         the agent image used to *be* the node: image
#                                   (prebuilt tarball by default; NODE_SOURCE=build
#                                   compiles it instead)
#   CPython + uv + podman-compose   Debian's python3 would be a second 3.13 tree.
#                                   The proxy image takes this tree too, so the two
#                                   images cannot drift onto different interpreters
#   podman                          trixie has 5.4.2 (Mar 2025); this builds 6.0.2
#                                   with an explicit BUILDTAGS set
#   netavark + aardvark-dns         podman 6 requires 2.0.0; trixie has 1.14.0
#
# WHY A SEPARATE IMAGE AND NOT A STAGE OF pi-coding-agent/Containerfile
#   1. build.sh builds this once. A project-specific image rebuild (run.py, on a
#      change to a workspace's commands.sh) then only replays the COPY, so it can
#      never recompile anything. Before this split, a cache miss on the Python layer
#      turned a project rebuild into a ~10 minute PGO compile.
#   2. Nothing from the toolchains can leak into the shipped images. Go, Rust, four
#      source trees and their build caches are several GB; only the staged trees are
#      copied.
#
# WHY FOUR INDEPENDENT STAGES
# Each component builds FROM the same deps stage and stages into its own /out, so
# bumping one cannot invalidate the others. That matters because the costs are wildly
# uneven: with NODE_SOURCE=build, Node is ~65 minutes against CPython's ~3 and podman's
# ~2. In a single linear chain, whichever component sat above Node would make a podman
# bump cost a full Node rebuild.
#
# The base image is deliberately the SAME one the agent image uses. Everything staged
# here is dynamically linked against that image's glibc, OpenSSL and SQLite, so
# building against a different Debian point release invites an ABI skew that only shows
# up as a runtime symbol error inside the agent.
#
# WHERE THE VERSIONS LIVE
# Every version, git commit and sha256 this image builds from is an ARG in this file,
# declared on the stage that consumes it. The build scripts read them from the
# environment (podman exports build args to RUN) and assert their presence via
# require_env — none of them defaults in a script, so this file is the only answer to
# "what is this image built from?", and bumping anything is an edit here.
#
# It also makes every pin overridable for a one-off build without touching a tracked
# file, e.g. --build-arg PODMAN_VERSION=v6.1.0 --build-arg PODMAN_COMMIT=<sha>.

# ─── Rust (shared) ───────────────────────────────────────────────────────────
# Declared before the first FROM, consumed by the rust stage (and overridable via
# --build-arg RUST_VERSION=...). Hashes come from
# https://static.rust-lang.org/dist/channel-rust-stable.toml.
ARG RUST_VERSION=1.99.1
ARG RUST_DIST_DATE=2026-10-15
ARG RUST_SHA256_X86_64=aded4e6c1d580415e7b594a3080d8e23e9cbe06f159f97e300aa6875211f71bf
ARG RUST_SHA256_AARCH64=703b190f0d723ae68985797f3bb5f62f01b1723f138464c6f30f32b766eb0abf

FROM debian:13.7-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS deps

# Everything that will be copied into the agent image is staged here, mirroring its
# final layout: /out/usr/local/bin/podman → /usr/local/bin/podman.
ENV PI_STAGE=/out

# Build dependencies for every script below, grouped by what needs them. None of this
# is shipped — the agent image installs its own (smaller) runtime set.
#
# The python* block is the one place this list overlaps with the agent image, which
# keeps the same -dev packages so `uv sync`/`pip install` can still build native
# wheels from source in a workspace. Keep the two in step.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # common
    build-essential \
    ca-certificates \
    curl \
    git \
    make \
    pkg-config \
    xz-utils \
    # python
    libbz2-dev \
    libdb5.3-dev \
    libexpat1-dev \
    libffi-dev \
    libgdbm-dev \
    liblzma-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libreadline-dev \
    libsqlite3-dev \
    libssl-dev \
    libzstd-dev \
    uuid-dev \
    zlib1g-dev \
    # node: its configure and GYP are Python scripts
    python3 \
    # podman: seccomp for the seccomp build tag, sqlite3 for libsqlite3
    libseccomp-dev \
    # netavark: its build.rs generates the dhcp-proxy's protobuf bindings
    protobuf-compiler \
 && rm -rf /var/lib/apt/lists/*

COPY pi-coding-agent-builder/common.sh /build/common.sh

# ─── CPython + uv + podman-compose ───────────────────────────────────────────
# MAKE_JOBS caps make parallelism. The script derives a safe default from available
# MEMORY rather than core count (a PGO compile peaks near 900 MiB per job and the
# default podman machine has 2 GiB), so override it only to go lower on a
# constrained builder or higher on a large one.
# PYTHON_OPTIMIZE=0 skips the PGO build (~10-20% slower Python, but a fraction of
# the memory and time) for builders that cannot fit a ~900 MiB compile job.
FROM deps AS python
ARG PYTHON_VERSION=3.14.6
ARG PYTHON_SHA256=74d0d71d0600e477651a077101d6e62d1e2e69b8e992ba18c993dd643b7ba222
