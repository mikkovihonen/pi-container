# ─── The shipped artefact ────────────────────────────────────────────────────
# Nothing but the staged trees: no toolchains, no package manager, no shell. This
# image exists to be COPYed --from, and keeping it at exactly its payload (rather than
# ~1.7 GB of build environment) is the point of staging in the first place.
#
# WHY ONE ROOT PER COMPONENT AND NOT ONE MERGED /out
# `COPY --from=<image>` can only address paths, not stages — an image tag exposes
# whichever tree this final stage lays down. Keeping the components at separate roots
# is what lets a consumer take a SUBSET: pi-coding-agent-proxy/Containerfile copies
# /python/ alone, so it runs the same CPython and the same uv as the agent without
# also carrying Node, podman and netavark into the network chokepoint. The agent image
# copies all four, one COPY each.
#
# The alternative — a merged /out plus a second copy of the Python tree for the proxy —
# was rejected: that tree is ~380 MB, and duplicating it inside this image to work
# around a layout choice is the wrong trade.
#
# Each root mirrors the final layout on its own: /python/usr/local/bin/uv →
# /usr/local/bin/uv. The trees are disjoint by construction — each component owns its
# own paths under /usr/local — except for the per-script manifest fragments in
# toolchain-versions.d/, which is precisely why stage_record() writes one file per
# script instead of appending to a shared one: copied into the same image, they merge
# instead of clobbering each other.
FROM scratch AS stage
COPY --from=python /out/ /python/
COPY --from=node /out/ /node/
COPY --from=podman /out/ /podman/
COPY --from=network /out/ /network/
COPY --from=go /out/ /go/
COPY --from=rust /out/ /rust/
LABEL pi-container.type="shared"
