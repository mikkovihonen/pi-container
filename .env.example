# SECURITY: ADMIN_PASSWORD MUST be changed from CHANGEME before running.
# The proxy's mitmweb UI will refuse to start with this default value.
ADMIN_PASSWORD=CHANGEME

# podman is the only supported runtime; leave unset to auto-detect it.
# CONTAINER_RUNTIME=podman

# Network settings have per-runtime defaults and rarely need overriding.
# BRIDGE_INTERFACE=podman0
# PROXY_UPSTREAM_NETWORK=podman
# (IPv6 is a per-project setting: network.ipv6 in .pi-container/config.yaml)

# For example: Homebrew on macOS
LLAMA_BIN=/opt/homebrew/bin/llama-server

LOG_LEVEL=INFO

PI_IMAGE_TAG=pi-coding-agent:local
PROXY_IMAGE_TAG=pi-coding-agent-proxy:local
# Toolchain image the agent image copies node/python/podman/netavark from. The tag is
# also referenced by name in pi-coding-agent/Containerfile's COPY --from, so
# changing it here alone is not enough.
BUILDER_IMAGE_TAG=pi-coding-agent-builder:local
# NODE_SOURCE=build compiles Node from source in the toolchain image instead of staging
# the official nodejs.org tarball. Costs about an hour and buys a trixie-native build
# rather than the generic-glibc one; nothing else.
#NODE_SOURCE=build



